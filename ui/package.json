{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"update": "npx npm-check-updates -i --format group",
		"dev": "vite dev --port 5180",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(npm run compile-i18n && svelte-kit sync) || echo ''",
		"compile-i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "npm run compile-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "npm run compile-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
		"format": "prettier --write . --ignore-path .prettierignore",
		"format:check": "prettier --check . --ignore-path .prettierignore",
		"lint": "npm run format:check && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"generate-api": "./scripts/generate-api.sh"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/lucide": "^1.2.107",
		"@inlang/paraglide-js": "2.18.0",
		"@openapitools/openapi-generator-cli": "2.32.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.59.1",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.3.1",
		"@types/node": "25.7.0",
		"@unocss/reset": "66.6.8",
		"bits-ui": "2.18.1",
		"eslint": "10.3.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.17.1",
		"globals": "17.6.0",
		"jsdom": "29.1.1",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.2",
		"svelte": "5.55.5",
		"svelte-check": "4.4.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.3",
		"unocss": "66.6.8",
		"vite": "7.3.3",
		"vitest": "4.1.6"
	},
	"dependencies": {
		"@tanstack/svelte-virtual": "^3.13.24",
		"lucide-svelte": "1.0.1"
	}
}
