{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"update": "npx npm-check-updates -i --format group",
		"dev": "vite dev --port 5180",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(npm run compile-i18n && svelte-kit sync) || echo ''",
		"compile-i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "npm run compile-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "npm run compile-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
		"format": "prettier --write . --ignore-path .prettierignore",
		"format:check": "prettier --check . --ignore-path .prettierignore",
		"lint": "npm run format:check && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"generate-api": "./scripts/generate-api.sh"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "10.0.1",
		"@iconify-json/lucide": "^1.2.142",
		"@inlang/paraglide-js": "^2.27.0",
		"@openapitools/openapi-generator-cli": "^2.39.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.5",
		"@unocss/reset": "^66.11.0",
		"bits-ui": "^2.19.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.1",
		"unocss": "^66.11.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@tanstack/svelte-virtual": "^3.13.41",
		"lucide-svelte": "1.0.1"
	},
	"overrides": {
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
