{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"update": "npx npm-check-updates -i --format group",
		"dev": "vite dev --port 5180",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(npm run compile-i18n && svelte-kit sync) || echo ''",
		"compile-i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "npm run compile-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "npm run compile-i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
		"format": "prettier --write . --ignore-path .prettierignore",
		"format:check": "prettier --check . --ignore-path .prettierignore",
		"lint": "npm run format:check && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"generate-api": "./scripts/generate-api.sh"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/lucide": "^1.2.116",
		"@inlang/paraglide-js": "^2.20.2",
		"@openapitools/openapi-generator-cli": "^2.40.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.0",
		"@unocss/reset": "^66.7.4",
		"bits-ui": "2.18.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "17.7.0",
		"jsdom": "29.1.1",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.62.1",
		"unocss": "^66.7.4",
		"vite": "8.1.3",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@tanstack/svelte-virtual": "^3.13.31",
		"lucide-svelte": "1.0.1"
	}
}
